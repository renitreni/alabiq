# Alabiq — Laravel app env (full-Laravel stack, repo root = app root).
# Copy to .env:  cp .env.example .env
# Then at minimum set: APP_KEY, the three compose passwords below, and any
# SMTP / pusher / payment keys you exercise.

# --- App ---
APP_NAME=Alabiq
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# php artisan key:generate
APP_KEY=

# --- Database (host values; docker-compose overrides these in-container) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alabiq
DB_USERNAME=alabiq_app
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=redis

# --- Realtime: pusher.com ---
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Object storage (MinIO; AWS_* names are what config/filesystems.php reads) ---
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BUCKET=alabiq-media

# --- Docker compose interpolation (docker-compose.yml ${...} references) ---
# POSTGRES_PASSWORD / APP_DB_PASSWORD / MINIO_ROOT_PASSWORD are REQUIRED by compose.
POSTGRES_DB=alabiq
POSTGRES_USER=alabiq
POSTGRES_PASSWORD=
APP_DB_USER=alabiq_app
APP_DB_PASSWORD=
MINIO_ROOT_USER=alabiq
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=alabiq-media
WEB_PORT=8080

# --- Maps ---
MAPBOX_ACCESS_TOKEN=

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=

# --- Payments: STC Pay (manual bank transfer, live path) ---
SMART_ALABIQ_STCPAY_NUMBER=
SMART_ALABIQ_STCPAY_NAME=Alabiq
# MUST stay false in production (auto-verifies proofs without admin review).
AUTO_VERIFY_STCPAY_TEST_MODE=false

# --- Payments: Tap (env-gated, off unless configured) ---
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_MERCHANT_ID=
TAP_API_BASE=https://api.tap.company

# --- Web push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@alabiq.com

# --- Feature flags / access ---
SHOP_ENABLED=false
ADMIN_EMAILS=
