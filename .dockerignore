# Alabiq — repo root IS the Laravel app (full-Laravel stack).
# Keep image builds lean and secret-free: everything the images need is
# composer/npm-installed or built in-image.

# --- VCS / editor / OS ---
.git/
.gitignore
.gitattributes
.idea/
.vscode/
.DS_Store
*.md
!README.md

# --- Dependencies (installed inside the images) ---
node_modules/
vendor/

# --- Build output (rebuilt in-image by the Vite stage) ---
public/build/
public/hot

# --- Secrets / local env — never bake into images ---
.env
.env.*
!.env.example
.alabiq-server-credentials.env

# --- Runtime state (dirs are recreated + chowned in the Dockerfile) ---
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# --- Local-only content ---
archive/
docs/
tmp/
.phpunit.cache/
phpunit.xml
tests/
coverage/
