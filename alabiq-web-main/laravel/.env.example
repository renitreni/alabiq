# ==========================================================
# Alabiq Laravel Backend - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env.
# ==========================================================

APP_NAME="Alabiq"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.alabiq.com
APP_SIGNING_KEY=

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=alabiq
DB_USERNAME=alabiq_app
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# --- Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Object Storage (MinIO / S3-compatible) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://minio:9000
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- CORS ---
# Comma-separated allow-list. Empty = loud warning + permissive pilot.
# Include BOTH Capacitor WebView origins: https://localhost (Android) and capacitor://localhost (iOS)
CORS_ORIGINS=https://alabiq.com,https://www.alabiq.com,https://localhost,capacitor://localhost

# --- Platform ---
PLATFORM_TIMEZONE=Asia/Riyadh

# --- Payments: STC Pay ---
AUTO_VERIFY_STCPAY_TEST_MODE=false
SMART_ALABIQ_STCPAY_NUMBER=
SMART_ALABIQ_STCPAY_NAME=Alabiq

# --- Tap Payments (Card) ---
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_MERCHANT_ID=
TAP_API_BASE=https://api.tap.company
TAP_APPLE_PAY_ENABLED=false
TAP_ALLOW_NON_3DS_ON_FILE=false
TAP_MAX_SAVED_CARDS=5

# --- Public URLs (for webhooks/redirects) ---
PUBLIC_WEB_URL=https://alabiq.com
PUBLIC_API_BASE=https://api.alabiq.com

# --- Realtime ---
REALTIME_INTERNAL_URL=http://realtime:4100
REALTIME_PUBLISH_TOKEN=

# --- Admin ---
# Comma-separated emails that become admins on sign-in/sync
ADMIN_EMAILS=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@alabiq.com

# --- Feature Flags ---
SHOP_ENABLED=false
PARTNER_API_ENABLED=false
WORKER_ENABLED=false
LEGACY_FOOD_MARKETPLACE_ENABLED=true

# --- Mapbox ---
MAPBOX_ACCESS_TOKEN=

# --- Logging ---
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Cache ---
CACHE_STORE=redis
CACHE_PREFIX=alabiq_

# --- Queue ---
QUEUE_CONNECTION=redis

# --- Session ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

# --- Sanctum / Auth ---
SANCTUM_STATEFUL_DOMAINS=alabiq.com,www.alabiq.com,localhost