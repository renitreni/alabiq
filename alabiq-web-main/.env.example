# ==========================================================
# Alabiq — full-Laravel stack environment (single .env)
# Copy to .env and fill in real values. NEVER commit the real .env.
#
# This one file feeds BOTH:
#   1. docker compose variable interpolation (${...} in docker-compose.yml)
#   2. the Laravel app containers (passed through via env_file)
# Infra-pointing vars (DB_HOST, REDIS_HOST, AWS_ENDPOINT, ...) are set
# explicitly in docker-compose.yml and override whatever is here.
# ==========================================================

# --- App (Laravel) ---
APP_NAME="Alabiq"
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate --show   (REQUIRED)
APP_KEY=
APP_URL=https://alabiq.com
APP_SIGNING_KEY=

# --- Compose: PostgreSQL ---
POSTGRES_DB=alabiq
POSTGRES_USER=alabiq
POSTGRES_PASSWORD=postgres123
APP_DB_USER=alabiq_app
APP_DB_PASSWORD=apppass123

# --- Compose: MinIO ---
MINIO_ROOT_USER=alabiq
MINIO_ROOT_PASSWORD=minio123456
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://minio:9000
AWS_BUCKET=alabiq
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Compose: Redis / Realtime ---
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REALTIME_INTERNAL_URL=http://realtime:4100
REALTIME_PUBLISH_TOKEN=realtime-token-123

# --- Web ---
WEB_PORT=8080

# --- Database (Laravel app; compose overrides HOST/PORT/DB/CREDS) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=alabiq
DB_USERNAME=alabiq_app
DB_PASSWORD=

# --- Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS ---
# Comma-separated allow-list. Empty = loud warning + permissive pilot.
# Include BOTH Capacitor WebView origins: https://localhost (Android) and capacitor://localhost (iOS)
CORS_ORIGINS=https://alabiq.com,https://www.alabiq.com,https://localhost,capacitor://localhost

# --- Platform ---
PLATFORM_TIMEZONE=Asia/Riyadh

# --- Payments: STC Pay ---
AUTO_VERIFY_STCPAY_TEST_MODE=false
SMART_ALABIQ_STCPAY_NUMBER=
SMART_ALABIQ_STCPAY_NAME=Alabiq

# --- Tap Payments (Card) ---
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_MERCHANT_ID=
TAP_API_BASE=https://api.tap.company
TAP_APPLE_PAY_ENABLED=false
TAP_ALLOW_NON_3DS_ON_FILE=false
TAP_MAX_SAVED_CARDS=5

# --- Public URLs (for webhooks/redirects) ---
PUBLIC_WEB_URL=https://alabiq.com
PUBLIC_API_BASE=https://api.alabiq.com

# --- Admin ---
# Comma-separated emails that become admins on sign-in/sync
ADMIN_EMAILS=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@alabiq.com

# --- Feature Flags ---
SHOP_ENABLED=false
PARTNER_API_ENABLED=false
WORKER_ENABLED=false
LEGACY_FOOD_MARKETPLACE_ENABLED=true

# --- Mapbox ---
MAPBOX_ACCESS_TOKEN=

# --- Logging ---
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Cache / Queue / Session ---
CACHE_STORE=redis
CACHE_PREFIX=alabiq_
QUEUE_CONNECTION=redis
# file (not database) until a Laravel sessions table exists — auth uses app_sessions
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null

# --- Sanctum / Auth ---
SANCTUM_STATEFUL_DOMAINS=alabiq.com,www.alabiq.com,localhost

# --- Partner API (delivery-as-a-service) ---
PARTNER_API_RATE_LIMIT_PER_MINUTE=120
PARTNER_QUOTE_TTL_SECONDS=600
PARTNER_IDEMPOTENCY_RETENTION_HOURS=24
PARTNER_WEBHOOK_SECRET_KEY=webhook-secret-123
PARTNER_WEBHOOK_TIMEOUT_MS=5000
PARTNER_WEBHOOK_RETRY_WINDOW_HOURS=24

# --- Worker (background job processor) ---
WORKER_DISPATCH_CONCURRENCY=5
WORKER_WEBHOOK_CONCURRENCY=3
WORKER_GPS_SAMPLING_CONCURRENCY=2
WORKER_JOB_LEASE_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_MS=10000

# --- Redis GPS hot path ---
LOCATION_REDIS_TTL_SECONDS=90
LOCATION_SAMPLING_INTERVAL_SECONDS=10
LOCATION_ACCURACY_THRESHOLD_METERS=100
LOCATION_MAX_PLAUSIBLE_SPEED_KMH=120
LOCATION_INGESTION_MAX_CONCURRENT=200
