# Compose configuration. Generate random values before local or server use.
POSTGRES_DB=alabiq
POSTGRES_USER=alabiq
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_DB_USER=alabiq_app
APP_DB_PASSWORD=replace-with-another-long-random-password
REALTIME_PUBLISH_TOKEN=replace-with-a-separate-long-random-token
MINIO_ROOT_USER=alabiq
MINIO_ROOT_PASSWORD=replace-with-a-strong-random-password
WEB_PORT=8080

# --- Partner API (delivery-as-a-service) ---
# Feature-flagged. Phase 6 pilot: enabled for one test branch/credential.
# LEGACY_FOOD_MARKETPLACE_ENABLED remains true so legacy marketplace orders continue.
PARTNER_API_ENABLED=true
LEGACY_FOOD_MARKETPLACE_ENABLED=true
PARTNER_API_RATE_LIMIT_PER_MINUTE=120
PARTNER_QUOTE_TTL_SECONDS=600
PARTNER_IDEMPOTENCY_RETENTION_HOURS=24
PARTNER_WEBHOOK_SECRET_KEY=replace-with-a-long-random-secret
PARTNER_WEBHOOK_TIMEOUT_MS=5000
PARTNER_WEBHOOK_RETRY_WINDOW_HOURS=24

# --- Worker (background job processor) ---
# Must be enabled alongside PARTNER_API_ENABLED for dispatch and webhook delivery.
WORKER_ENABLED=true
WORKER_DISPATCH_CONCURRENCY=5
WORKER_WEBHOOK_CONCURRENCY=3
WORKER_GPS_SAMPLING_CONCURRENCY=2
WORKER_JOB_LEASE_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_MS=10000

# --- Redis GPS hot path ---
LOCATION_REDIS_TTL_SECONDS=90
LOCATION_SAMPLING_INTERVAL_SECONDS=10
LOCATION_ACCURACY_THRESHOLD_METERS=100
LOCATION_MAX_PLAUSIBLE_SPEED_KMH=120
