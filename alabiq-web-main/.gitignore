# Alabiq — Laravel application root .gitignore
# (Merged from the old project-root net + Laravel standard + mobile/ rules moved to mobile/.gitignore)

# Laravel
/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
!/storage/framework/*/.gitignore
/vendor
.env
.env.backup
.env.production
.env.testing
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

# Realtime service
realtime/node_modules/

# Never commit real environment files — only the .example templates.
!.env.example

# Documentation is local/private reference only and never ships to GitHub.
# docs/ carries the deployment topology, the confidential margin/net_price money
# model, security audit findings, and the admin runbook.
docs/

# Local Docker env (compose interpolation source — keep out of git)
compose.env

# Logs & OS/editor cruft
*.log
.DS_Store
*.sw?

# Laravel bootstrap cache
/bootstrap/cache/*.php
!.gitignore
